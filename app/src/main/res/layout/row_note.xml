<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp"
    android:orientation="vertical" android:background="@drawable/panel" android:padding="14dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textStyle="bold" android:textColor="#173D35" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="#66766E" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
